# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# --- Geotab (HOS / driver readiness) ---
GEOTAB_ACCOUNT_1_NAME=Your Company Name
GEOTAB_ACCOUNT_1_SERVER=my.geotab.com
GEOTAB_ACCOUNT_1_DATABASE=your_database
GEOTAB_ACCOUNT_1_USERNAME=you@example.com
GEOTAB_ACCOUNT_1_PASSWORD=your_password
# Add more accounts with GEOTAB_ACCOUNT_2_*, GEOTAB_ACCOUNT_3_*, ... (up to 10)

# --- Netradyne (Playwright headless login for alert scraping) ---
NETRADYNE_EMAIL=your_netradyne_user
NETRADYNE_PASSWORD=your_netradyne_password
NETRADYNE_POLL_INTERVAL_MS=60000

# --- Telegram alerts (optional; push works without these) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often the server polls Geotab for HOS alerts while running (ms)
HOS_ALERT_POLL_MS=120000

# --- Server ---
PORT=4174
# Set USE_HTTP=1 when running behind a TLS-terminating proxy/tunnel or cloud host (Railway).
# Leave unset for local HTTPS with the self-signed cert.
USE_HTTP=

# --- Web Push (VAPID) ---
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Reuse the SAME keys across deploys so existing push subscriptions stay valid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ndk-dispatch.com
